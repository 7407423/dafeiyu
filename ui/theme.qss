/* 大肥鱼 v2 · 深蓝夜色主题（鲸鱼色） */

* { font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif; }

QMainWindow, QWidget#Root { background: #0d1117; }

QWidget { color: #d7e3f4; font-size: 13px; }

QLabel#Title { font-size: 20px; font-weight: 700; color: #e8f2ff; }
QLabel#Subtitle { color: #8fa6c4; font-size: 12px; }
QLabel#Hint { color: #7b8ea8; font-size: 12px; }
QLabel#Danger { color: #ff8d8d; }
QLabel#Good { color: #8be3a8; }

QFrame#Card {
  background: #131a24;
  border: 1px solid #1e2a3a;
  border-radius: 10px;
}
QFrame#Card:hover { border: 1px solid #2b3d55; }

QWidget#SideHolder { background: #0d1117; }
QWidget#SideHolder QWidget { background: #0d1117; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollArea#SideScroll { background: #0d1117; border: none; }
QScrollArea#SideScroll > QWidget#qt_scrollarea_viewport { background: #0d1117; }

QPushButton#Section {
  background: transparent;
  border: none;
  color: #dbe8f8;
  font-size: 14px;
  font-weight: 700;
  text-align: left;
  padding: 9px 12px;
  border-radius: 8px;
}
QPushButton#Section:hover { background: #18222f; }
QPushButton#Section:checked { background: #16202c; color: #ffffff; }

QPushButton#Sub {
  background: transparent;
  border: none;
  color: #a9bed8;
  font-size: 13px;
  font-weight: 400;
  text-align: left;
  padding: 6px 12px 6px 20px;
  border-radius: 6px;
}
QPushButton#Sub:hover { background: #161f2b; color: #d7e3f4; }
QPushButton#Sub:checked { background: #14202e; color: #e8f2ff; }

QWidget#SectionBody { background: transparent; }

QTextBrowser, QPlainTextEdit, QListWidget, QTreeWidget, QTableWidget {
  background: #0f1620;
  border: 1px solid #1c2634;
  border-radius: 8px;
  padding: 6px;
  selection-background-color: #23405f;
  color: #cfe0f5;
}

QLineEdit {
  background: #0f1620;
  border: 1px solid #22303f;
  border-radius: 16px;
  padding: 9px 14px;
  color: #e6f1ff;
}
QLineEdit:focus { border: 1px solid #3f6d9e; }

QPushButton {
  background: #1b2b3d;
  border: 1px solid #27405a;
  border-radius: 8px;
  padding: 7px 14px;
  color: #d7e3f4;
}
QPushButton:hover { background: #22374e; border-color: #37608a; }
QPushButton:pressed { background: #16232f; }
QPushButton#Primary { background: #2b6cb0; border-color: #3b82f6; color: #ffffff; font-weight: 600; }
QPushButton#Primary:hover { background: #3b82f6; }
QPushButton#Ghost { background: transparent; border: 1px solid #22303f; color: #9db4d0; }
QPushButton:disabled { color: #5b6b7d; border-color: #1b2530; background: #121a23; }

QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #22303f; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #2f4560; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle:horizontal { background: #22303f; border-radius: 4px; }

QSplitter::handle { background: #10171f; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }

QCheckBox { spacing: 8px; color: #b9cde6; }
QCheckBox::indicator { width: 15px; height: 15px; border-radius: 4px; border: 1px solid #2f4560; background: #0f1620; }
QCheckBox::indicator:checked { background: #2b6cb0; border-color: #3b82f6; }

QComboBox {
  background: #0f1620; border: 1px solid #22303f; border-radius: 8px; padding: 5px 10px; color: #d7e3f4;
}

QTabWidget::pane { border: 1px solid #1c2634; border-radius: 8px; }
QTabBar::tab { background: #101821; color: #9db4d0; padding: 7px 14px; border-radius: 6px; margin-right: 4px; }
QTabBar::tab:selected { background: #1b2b3d; color: #e8f2ff; }

QProgressBar { background: #0f1620; border: none; border-radius: 4px; height: 8px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #2b6cb0; border-radius: 4px; }

QFrame#BubbleMe { background: #1d3350; border: 1px solid #2b4a6e; border-radius: 12px; }
QFrame#BubbleHer { background: #151f2b; border: 1px solid #22303f; border-radius: 12px; }
QLabel#BubbleText { color: #e6f1ff; font-size: 13px; }

/* ── v12 4.2 双视图外壳 ── */
QFrame#CostStrip {
  background: #101821; border: 1px solid #1c2634; border-radius: 10px;
}
QPushButton#Function {
  background: transparent; border: 1px solid transparent; border-radius: 7px;
  padding: 7px 6px; text-align: center; color: #9db4d0;
}
QPushButton#Function:hover { background: #16232f; color: #d7e3f4; }
QPushButton#Function[active="true"] {
  background: #1b2b3d; border-color: #2b4a6e; color: #e8f2ff; font-weight: 600;
}
QListWidget {
  background: #0f1620; border: 1px solid #1c2634; border-radius: 8px;
  color: #b9cde6; padding: 4px;
}
QListWidget::item { padding: 7px 8px; border-radius: 6px; }
QListWidget::item:selected { background: #1b2b3d; color: #e8f2ff; }
QTextEdit, QLineEdit {
  background: #0f1620; border: 1px solid #22303f; border-radius: 8px; padding: 6px; color: #d7e3f4;
}
QSlider::groove:horizontal { height: 6px; background: #16232f; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #2b6cb0; border-radius: 3px; }
QSlider::handle:horizontal {
  background: #e8f2ff; width: 14px; margin: -5px 0; border-radius: 7px;
}
QMessageBox { background: #0d1117; }
QMessageBox QLabel { color: #d7e3f4; }
QLabel#BubbleMeta { color: #7b8ea8; font-size: 11px; }
